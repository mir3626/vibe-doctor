{
  "$ref": "#/definitions/ProRoundtripFlow",
  "definitions": {
    "ProRoundtripFlow": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "vibe-pro-flow-v1"
        },
        "flowPath": {
          "type": "string",
          "pattern": "^flows\\/[0-9]{8}\\/[0-9]{3}-[a-z0-9][a-z0-9-]{1,58}[a-z0-9]$"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,58}[a-z0-9]$"
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "nonGoals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repository": {
          "type": "object",
          "properties": {
            "fullName": {
              "type": "string",
              "pattern": "^[^/\\s]+\\/[^/\\s]+$"
            },
            "remoteUrl": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "fullName",
            "remoteUrl"
          ],
          "additionalProperties": false
        },
        "bridgeBranch": {
          "type": "string",
          "const": "vibe-pro-bridge"
        },
        "codeBranch": {
          "type": "string",
          "minLength": 1
        },
        "baseSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "protocol": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^v[1-9][0-9]*(-[0-9a-f]{8})?$"
            },
            "commitSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "commonHarnessSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "version",
            "commitSha",
            "commonHarnessSha256"
          ],
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "createdBy": {
          "type": "string",
          "enum": [
            "cli",
            "pro"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "flowPath",
        "date",
        "sequence",
        "slug",
        "goal",
        "nonGoals",
        "repository",
        "bridgeBranch",
        "codeBranch",
        "baseSha",
        "protocol",
        "createdAt",
        "timezone",
        "createdBy"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
