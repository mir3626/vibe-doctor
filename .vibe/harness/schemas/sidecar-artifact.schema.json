{
  "$ref": "#/definitions/SidecarArtifact",
  "definitions": {
    "SidecarArtifact": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "sidecar": {
          "type": "string",
          "enum": [
            "diff-reviewer"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "advisory",
            "fail",
            "error",
            "unavailable"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "findings": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "recommendation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            },
            "required": [
              "severity",
              "confidence",
              "file",
              "message",
              "recommendation"
            ]
          }
        },
        "limitations": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "coverage": {
          "type": "object",
          "properties": {
            "inputFilesSeen": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "diffBytesSeen": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "inputFilesSeen",
            "diffBytesSeen",
            "truncated"
          ]
        },
        "provider": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "mock"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "modelProvenance": {
          "type": "object",
          "properties": {
            "requestedModel": {
              "type": "string"
            },
            "requestedEffort": {
              "type": "string"
            },
            "effectiveModel": {
              "type": "null"
            },
            "effectiveEffort": {
              "type": "null"
            }
          },
          "required": [
            "requestedModel",
            "requestedEffort",
            "effectiveModel",
            "effectiveEffort"
          ]
        },
        "effort": {
          "type": "string",
          "enum": [
            "high",
            "xhigh"
          ]
        },
        "sprintId": {
          "type": "string",
          "minLength": 1
        },
        "gitSha": {
          "type": "string",
          "minLength": 1
        },
        "inputHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "stderrPreview": {
          "type": "string",
          "maxLength": 4000
        },
        "rawPreview": {
          "type": "string",
          "maxLength": 4000
        },
        "error": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "schemaVersion",
        "sidecar",
        "status",
        "summary",
        "findings",
        "limitations",
        "coverage",
        "provider",
        "model",
        "effort",
        "sprintId",
        "gitSha",
        "inputHash",
        "createdAt",
        "expiresAt",
        "durationMs",
        "exitCode"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
