{
  "$ref": "#/definitions/ProRoundtripOperatorClose",
  "definitions": {
    "ProRoundtripOperatorClose": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "vibe-pro-operator-close-v1"
        },
        "flowPath": {
          "type": "string",
          "pattern": "^flows\\/[0-9]{8}\\/[0-9]{3}-[a-z0-9][a-z0-9-]{1,58}[a-z0-9]$"
        },
        "repositoryFullName": {
          "type": "string",
          "pattern": "^[^/\\s]+\\/[^/\\s]+$"
        },
        "codeBranch": {
          "type": "string",
          "minLength": 1
        },
        "baseSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "codeHeadSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sourceBridgeSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "disposition": {
          "type": "string",
          "const": "force-closed"
        },
        "authorizedBy": {
          "type": "string",
          "const": "user"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\r\\n]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "schemaVersion",
        "flowPath",
        "repositoryFullName",
        "codeBranch",
        "baseSha",
        "codeHeadSha",
        "sourceBridgeSha",
        "disposition",
        "authorizedBy",
        "reason",
        "createdAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
