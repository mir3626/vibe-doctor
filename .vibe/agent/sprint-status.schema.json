                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "command": {
                      "type": "string"
                    },
                    "expectExitCode": {
                      "default": 0,
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
