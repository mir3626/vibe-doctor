{
  "$ref": "#/definitions/IterationHistory",
  "definitions": {
    "IterationHistory": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "currentIteration": {
          "type": [
            "string",
            "null"
          ]
        },
        "iterations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "startedAt": {
                "type": "string"
              },
              "completedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "goal": {
                "type": "string"
              },
              "plannedSprints": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "completedSprints": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "milestoneProgress": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "number"
                }
              },
              "summary": {
                "type": "string"
              },
              "carryover": {
                "type": "object",
                "properties": {
                  "backlogDoc": {
                    "type": "string"
                  },
                  "open": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": {},
                "description": "Un-implemented backlog carried into later iterations. Full detail lives in `backlogDoc` (a repo-relative path); `open` is a short headline list the differential interview reads without loading the whole doc."
              },
              "executionBinding": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "executionLane": {
                        "type": "string",
                        "const": "standalone-goal-iterate"
                      },
                      "proFlowPath": {
                        "type": "null"
                      }
                    },
                    "required": [
                      "executionLane",
                      "proFlowPath"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "executionLane": {
                        "type": "string",
                        "const": "pro-roundtrip"
                      },
                      "proFlowPath": {
                        "type": "string",
                        "pattern": "^flows\\/[0-9]{8}\\/[0-9]{3}-[a-z0-9][a-z0-9-]*$"
                      }
                    },
                    "required": [
                      "executionLane",
                      "proFlowPath"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "id",
              "label",
              "startedAt",
              "completedAt",
              "goal",
              "plannedSprints",
              "completedSprints",
              "milestoneProgress",
              "summary"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "currentIteration",
        "iterations"
      ],
      "additionalProperties": {}
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
